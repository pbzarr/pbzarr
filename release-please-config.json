        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='pbzarr')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='pbzarr-readers')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='pbzarr-python')].version" }
      ]
    }
  }
}
